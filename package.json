{
  "name": "wii-webcam-videogame",
  "version": "1.0.0",
  "description": "Wii Web Minigames with Smartphone Controller",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "tunnel": "npx localtunnel --port 8000",
    "start:electron": "electron .",
    "build:exe": "electron-builder --win"
  },
  "build": {
    "appId": "com.wiiweb.game",
    "productName": "Wii Web Videogame",
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  }
}
